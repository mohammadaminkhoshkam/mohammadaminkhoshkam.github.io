- name: iq_recorder
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nSDR Lab IQ Recorder -- Embedded Python Block (GNU Radio\
      \ 3.10)\n\nRecords raw complex64 I/Q samples to\n    teamID_labNN_fc_fs_gain_timestamp.cf32\n\
      e.g. Team-07_lab01_945000000_2600000_20.0_20261005T101502.cf32\n\nStates (Lab\
      \ 01 manual, Fig. 8):\n    IDLE      -- no file open; record = True opens a\
      \ new file -> RECORDING\n    RECORDING -- file open; closes when\n         \
      \          (a) record -> False                     -> IDLE\n               \
      \    (b) floor(max_seconds * fs) samples hit -> WAIT\n                   (c)\
      \ fc / fs / gain changed              -> WAIT\n                   (d) flowgraph\
      \ stopped (stop())\n    WAIT      -- file closed automatically; waits for record\
      \ -> False\n                 so that no new file is opened by itself  -> IDLE\n\
      \nPaste this file into an Embedded Python Block (Open in Editor) and set:\n\
      \    team, lab, fc=f_tune, fs=samp_rate, gain=rf_gain, record=rec,\n    max_seconds=rec_sec,\
      \ folder=\"recordings\"\n\"\"\"\n\nimport os\nimport time\n\nimport numpy as\
      \ np\nfrom gnuradio import gr\n\nIDLE, RECORDING, WAIT = 'IDLE', 'RECORDING',\
      \ 'WAIT'\n\n\nclass blk(gr.sync_block):\n    \"\"\"SDR Lab IQ Recorder: writes\
      \ raw complex64 I/Q (.cf32) with the\n    standard lab file name. Tick `record`\
      \ to start; the file closes when\n    the tick is removed, after max_seconds,\
      \ when fc/fs/gain change, or\n    when the flowgraph stops.\"\"\"\n\n    def\
      \ __init__(self, team='Team-00', lab=1, fc=100e6, fs=2.6e6, gain=0.0,\n    \
      \             record=False, max_seconds=5.0, folder='.'):\n        gr.sync_block.__init__(\n\
      \            self,\n            name='SDR Lab IQ Recorder',\n            in_sig=[np.complex64],\n\
      \            out_sig=None,\n        )\n        # Same names as the arguments,\
      \ so GRC callbacks update them at run time.\n        self.team = team\n    \
      \    self.lab = lab\n        self.fc = fc\n        self.fs = fs\n        self.gain\
      \ = gain\n        self.record = record\n        self.max_seconds = max_seconds\n\
      \        self.folder = folder\n\n        self._state = IDLE\n        self._file\
      \ = None\n        self._path = ''\n        self._settings = None    # (fc, fs,\
      \ gain) at the moment the file opened\n        self._target = 0         # floor(max_seconds\
      \ * fs)\n        self._written = 0\n\n    # ----------------------------------------------------------------\
      \ helpers\n    def _current_settings(self):\n        return (int(round(float(self.fc))),\n\
      \                int(round(float(self.fs))),\n                round(float(self.gain),\
      \ 1))\n\n    def _open(self):\n        fc, fs, gain = self._settings = self._current_settings()\n\
      \        folder = str(self.folder) or '.'\n        os.makedirs(folder, exist_ok=True)\n\
      \        stamp = time.strftime('%Y%m%dT%H%M%S')\n        name = '{}_lab{:02d}_{}_{}_{:.1f}_{}.cf32'.format(\n\
      \            self.team, int(self.lab), fc, fs, gain, stamp)\n        self._path\
      \ = os.path.join(folder, name)\n        self._file = open(self._path, 'wb')\n\
      \        self._target = int(np.floor(float(self.max_seconds) * fs))\n      \
      \  self._written = 0\n        self._state = RECORDING\n        print('[REC]\
      \ start {}'.format(name), flush=True)\n\n    def _close(self, reason, next_state):\n\
      \        if self._file is not None:\n            self._file.close()\n      \
      \      self._file = None\n            fs = self._settings[1] if self._settings\
      \ else float(self.fs)\n            print('[REC] stop  {} samples = {:.2f} s\
      \ ({})'.format(\n                self._written, self._written / fs, reason),\
      \ flush=True)\n        self._state = next_state\n\n    # -------------------------------------------------------------------\
      \ work\n    def work(self, input_items, output_items):\n        x = input_items[0]\n\
      \        record = bool(self.record)\n\n        if self._state == IDLE:\n   \
      \         if record:\n                self._open()\n        elif self._state\
      \ == WAIT:\n            if not record:\n                self._state = IDLE\n\
      \n        if self._state == RECORDING:\n            if not record:\n       \
      \         self._close('record unchecked', IDLE)\n            elif self._current_settings()\
      \ != self._settings:\n                # This buffer already belongs to the new\
      \ settings: do not write it.\n                self._close('fc/fs/gain changed',\
      \ WAIT)\n            else:\n                n = min(len(x), self._target - self._written)\n\
      \                if n > 0:\n                    x[:n].astype(np.complex64, copy=False).tofile(self._file)\n\
      \                    self._written += n\n                if self._written >=\
      \ self._target:\n                    self._close('max_seconds reached', WAIT)\n\
      \n        return len(x)\n\n    def stop(self):\n        self._close('flowgraph\
      \ stopped', IDLE)\n        return True\n"
    affinity: ''
    alias: ''
    comment: ''
    fc: f_tune
    folder: '"recordings"'
    fs: samp_rate
    gain: rf_gain
    lab: '1'
    max_seconds: rec_sec
    maxoutbuf: '0'
    minoutbuf: '0'
    record: rec
    team: team
  states:
    _io_cache: '(''SDR Lab IQ Recorder'', ''blk'', [(''team'', "''Team-00''"), (''lab'',
      ''1''), (''fc'', ''100000000.0''), (''fs'', ''2600000.0''), (''gain'', ''0.0''),
      (''record'', ''False''), (''max_seconds'', ''5.0''), (''folder'', "''.''")],
      [(''0'', ''complex'', 1)], [], ''SDR Lab IQ Recorder: writes raw complex64 I/Q
      (.cf32) with the\n    standard lab file name. Tick `record` to start; the file
      closes when\n    the tick is removed, after max_seconds, when fc/fs/gain change,
      or\n    when the flowgraph stops.'', [''fc'', ''folder'', ''fs'', ''gain'',
      ''lab'', ''max_seconds'', ''record'', ''team''])'
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [920, 688.0]
    rotation: 0
    state: enabled
