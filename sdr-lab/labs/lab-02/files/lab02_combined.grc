- name: plutocfg
  id: epy_module
  parameters:
    alias: ''
    comment: ''
    source_code: "# Which ADALM-PLUTO to talk to: $PLUTO_URI, else pluto_uri.txt written\
      \ by\r\n# preflight_check.py (0_check_setup.bat), else the lab default address.\r\
      \nimport os\r\n\r\n\r\ndef pluto_uri(default=\"ip:192.168.1.10\"):\r\n    uri\
      \ = os.environ.get(\"PLUTO_URI\")\r\n    # GRC evaluates this module without\
      \ __file__; the generated .py has it\r\n    here = os.path.dirname(os.path.abspath(__file__))\
      \ if \"__file__\" in globals() else os.getcwd()\r\n    path = os.path.join(here,\
      \ \"pluto_uri.txt\")\r\n    if not uri and os.path.exists(path):\r\n       \
      \ with open(path) as f:\r\n            uri = f.read().strip()\r\n    return\
      \ uri or default\r\n\r\n"
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [568, 248.0]
    rotation: 0
    state: enabled
- name: recorder
  id: epy_block
  parameters:
    _source_code: "\"\"\"GNU Radio Python Block: bounded cf32 recorder with JSON sidecar.\n\
      Runtime setters are explicit. A take cannot mix fc/fs/gain settings.\nTimestamp\
      \ is UTC; no file is overwritten. Data are little-endian complex64.\n\"\"\"\n\
      import os\nimport re\nimport json\nfrom datetime import datetime, timezone\n\
      import numpy as np\nfrom gnuradio import gr\n\nclass blk(gr.sync_block):\n \
      \   def __init__(self, team='Team-00', lab=2, fc=434e6, fs=8192000., gain=40.2,\n\
      \                 record=False, max_seconds=5.0, folder='.', f_corr=0.0):\n\
      \        gr.sync_block.__init__(self, name='SDR Lab IQ Recorder', in_sig=[np.complex64],\
      \ out_sig=None)\n        self.team,self.lab,self.fc,self.fs,self.gain=team,lab,fc,fs,gain\n\
      \        self.record,self.max_seconds,self.folder=record,max_seconds,folder\n\
      \        self.f_corr=f_corr\n        self._fh=None;self._armed=True;self._n=0;self._key=None\n\
      \    def set_team(self,v): self.team=v\n    def set_lab(self,v): self.lab=v\n\
      \    def set_fc(self,v): self.fc=v\n    def set_fs(self,v): self.fs=v\n    def\
      \ set_gain(self,v): self.gain=v\n    def set_record(self,v): self.record=v\n\
      \    def set_max_seconds(self,v): self.max_seconds=v\n    def set_folder(self,v):\
      \ self.folder=v\n    def set_f_corr(self,v): self.f_corr=v\n    def _settings(self):\
      \ return (self.fc,self.fs,self.gain,self.team,self.lab,self.folder,self.max_seconds,self.f_corr)\n\
      \    def _open(self):\n        if self.fs<=0 or self.max_seconds<=0: raise ValueError('fs\
      \ and max_seconds must be positive')\n        team=re.sub(r'[^A-Za-z0-9_-]','_',str(self.team))\n\
      \        stamp=datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%S%fZ')\n   \
      \     os.makedirs(self.folder,exist_ok=True)\n        self._path=os.path.join(self.folder,f'{team}_lab{int(self.lab):02d}_{round(self.fc)}_{round(self.fs)}_{self.gain:.1f}_{stamp}.cf32')\n\
      \        self._fh=open(self._path,'xb');self._n=0;self._key=self._settings()\n\
      \        self._meta=dict(origin='HARDWARE_CAPTURE',team=self.team,lab=int(self.lab),fc_hz=self.fc,fs_hz=self.fs,gain_db=self.gain,f_corr_hz=self.f_corr,dtype='little-endian\
      \ complex64',started_utc=stamp)\n    def _close(self,reason):\n        self._fh.close();self._fh=None;self._armed=False\n\
      \        self._meta.update(samples=self._n,duration_seconds=self._n/self._key[1],stop_reason=reason)\n\
      \        with open(self._path[:-5]+'.json','w',encoding='utf-8') as f: json.dump(self._meta,f,indent=2)\n\
      \    def work(self,input_items,output_items):\n        x=input_items[0]\n  \
      \      if not self.record:\n            if self._fh is not None: self._close('record\
      \ off')\n            self._armed=True\n        elif self._fh is None and self._armed:\
      \ self._open()\n        if self._fh is not None:\n            if self._settings()!=self._key:\
      \ self._close('settings changed; release record before next take')\n       \
      \     else:\n                left=max(0,int(self._key[6]*self._key[1])-self._n);n=min(len(x),left)\n\
      \                x[:n].astype('<c8',copy=False).tofile(self._fh);self._n+=n\n\
      \                if n==left: self._close('max_seconds reached')\n        return\
      \ len(x)\n    def stop(self):\n        if self._fh is not None: self._close('flowgraph\
      \ stopped')\n        return True\n"
    affinity: ''
    alias: ''
    comment: ''
    f_corr: f_corr
    fc: f_c
    folder: '''captures'''
    fs: samp_rate
    gain: rf_gain
    lab: '2'
    max_seconds: '5.0'
    maxoutbuf: '0'
    minoutbuf: '0'
    record: rec
    team: team
  states:
    _io_cache: ('SDR Lab IQ Recorder', 'blk', [('team', "'Team-00'"), ('lab', '2'),
      ('fc', '434000000.0'), ('fs', '8192000.0'), ('gain', '40.2'), ('record', 'False'),
      ('max_seconds', '5.0'), ('folder', "'.'"), ('f_corr', '0.0')], [('0', 'complex',
      1)], [], '', ['f_corr', 'fc', 'folder', 'fs', 'gain', 'lab', 'max_seconds',
      'record', 'team'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1432, 1008.0]
    rotation: 0
    state: enabled
