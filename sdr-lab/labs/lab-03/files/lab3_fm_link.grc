    bus_source: false
    bus_structure: null
    coordinate:
    - 1860
    - 480
    rotation: 0
    state: enabled
- name: deemph
  id: analog_fm_deemph
  parameters:
    samp_rate: audio_rate
    tau: tau
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 2060
    - 480
    rotation: 0
    state: enabled
- name: volume_gain
